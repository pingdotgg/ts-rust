{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "apiStabilityLeak": "warning", "unstableApiUsage": "off" }
      }
    ]
  },
  "include": ["src"]
}
