{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "unstableApiUsage": "error" },
        "allowedUnstableApis": ["effect/cli/Flag", "effect/http/HttpClient#HttpClient"],
        "overrides": [
          {
            "include": ["src/allowed.ts"],
            "options": {
              "allowedUnstableApis": ["effect/cli/Command#make", "effect/http/HttpClient#HttpClient", "effect/cli#Command"]
            }
          }
        ]
      }
    ]
  },
  "include": ["src"]
}
