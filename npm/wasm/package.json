{
    "name": "ts-rust-wasm",
    "version": "7.0.0-dev",
    "description": "The ts-rust TypeScript compiler and type checker (a Rust port of typescript-go) as WebAssembly",
    "license": "MIT AND Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pingdotgg/ts-rust.git",
        "directory": "npm/wasm"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "node": "./node.js",
            "default": "./browser.js"
        },
        "./core": {
            "types": "./core.d.ts",
            "default": "./core.js"
        },
        "./ts_rust.wasm": "./ts_rust.wasm",
        "./package.json": "./package.json"
    },
    "bin": {
        "tsc-wasm": "./bin/tsc-wasm.js"
    },
    "files": [
        "bin/tsc-wasm.js",
        "browser.js",
        "core.d.ts",
        "core.js",
        "file-map.js",
        "index.d.ts",
        "node-run.js",
        "node-worker.js",
        "node.js",
        "node-language-service.js",
        "language-service-worker.js",
        "scripts/check-typescript-api.mjs",
        "TYPESCRIPT_API_PLAN.md",
        "ts_rust.wasm"
    ],
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "scripts": {
        "build": "../../scripts/wasm/build.sh",
        "test": "node --test test/*.test.mjs",
        "check:typescript-api": "node scripts/check-typescript-api.mjs"
    }
}
